    "excalimath_latex": "\\hat A^{(k)}_t=\\sum_{l=0}^{k-1}\\gamma^l\\delta^V_{t+l}=-V(s_t)+r_t+\\dots+\\gamma^{k-1}r_{t+k-1}+\\gamma^kV(s_{t+k})"
   }
