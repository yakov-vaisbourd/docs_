      "link": null,
      "locked": false,
      "text": "formalized Approximate Policy Iteration (API). Chapter 6 is historically significant here because\nit exposed the fundamental instability of using function approximators (like neural networks) in\nreinforcement learning.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "formalized Approximate Policy Iteration (API). Chapter 6 is historically significant here because it exposed the fundamental instability of using function approximators (like neural networks) in reinforcement learning.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
