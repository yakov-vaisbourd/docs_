    {
      "id": "lQ5jd_OmQlcp3on_-HQ6w",
      "type": "text",
      "x": -17.656683692092884,
      "y": 709.9481985189278,
      "width": 772.6232299804688,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kM_ObKcKBUnvi4C643EdB",
        "z_XOiKbH2xr-m_Sk2dagt"
      ],
      "frameId": null,
      "index": "b3q",
      "roundness": null,
      "seed": 1525480355,
      "version": 528,
      "versionNonce": 392517315,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "link": null,
      "locked": false,
      "text": "The direct architectural precursor to DeepSeekMath's GRPO. It demonstrated that for LLMs, you\ncan completely drop PPO's memory-heavy value critic and construct an unbiased baseline using the\nmean reward of other samples generated from the same prompt.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The direct architectural precursor to DeepSeekMath's GRPO. It demonstrated that for LLMs, you can completely drop PPO's memory-heavy value critic and construct an unbiased baseline using the mean reward of other samples generated from the same prompt.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
