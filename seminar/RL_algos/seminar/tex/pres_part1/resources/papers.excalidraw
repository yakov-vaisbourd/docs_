    {
      "id": "VRGpvEUreuUHaRYVYwh11",
      "type": "text",
      "x": -17.656683692092884,
      "y": -35.49141944231485,
      "width": 775.0632178800706,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
