        "eUhTzcwonaEvYcQ26--OH",
        "w4unoiOOYEiy4Sk23y6nF"
      ],
      "boundElements": [],
      "link": null,
      "locked": false,
      "frameId": null,
      "hasTextLink": false,
      "fileId": "c30a0374309e87886b725b720ad2772dc4a69cbe",
      "customData": {
        "latex": "\\nabla_\\theta J(\\pi_\\theta) = \\mathbb{E}_{\\pi_\\theta} \\left[ \\nabla_\\theta \\log \\pi_\\theta(a|s) Q^{\\pi_\\theta}(s,a) \\right]"
      },
      "scale": [
        1,
        1
      ],
      "index": "b3Z",
      "status": "pending",
      "crop": null
    },
    {
      "id": "fxyP8f_RGumuRwcalcGGN",
      "type": "text",
      "x": -17.656683692092884,
      "y": -477.5351251257125,
      "width": 738.1319754464289,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pOfm4qBmMW57qWs0rAjka",
        "YqF3LJYeFUeeHyEAsvtzL"
      ],
      "frameId": null,
      "index": "b3a",
      "roundness": null,
      "seed": 112599459,
      "version": 624,
      "versionNonce": 235768259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "link": null,
      "locked": false,
      "text": "Extended Kakade & Langford's CPI mixture bound to arbitrary parametrized policies. This\nprovided the exact monotonic improvement lower bound that TRPO later optimized.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Extended Kakade & Langford's CPI mixture bound to arbitrary parametrized policies. This provided the exact monotonic improvement lower bound that TRPO later optimized.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
