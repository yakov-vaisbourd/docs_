    {
      "id": "_KI-zpPQexUvjTkuuQF9B",
      "type": "text",
      "x": -17.656683692092884,
      "y": 406.2846772633221,
      "width": 791.7234723812968,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
