      "boundElements": [],
      "updated": 1792485689470,
      "link": null,
      "locked": false,
      "text": "The foundation that proved you can optimize a parameterized policy directly by estimating the\ngradient of the expected return.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The foundation that proved you can optimize a parameterized policy directly by estimating the gradient of the expected return.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
    {
      "id": "xvbJnb2I6qN4VSIvn1oSl",
      "type": "image",
      "x": 206.8928554297354,
      "y": -829.4292302660292,
      "width": 273,
      "height": 15.999999999999998,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": null,
