      "versionNonce": 613794467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "locked": false,
      "text": "Scaled CPI's concepts to deep neural networks by using a KL-divergence constraint to enforce\na \"trust region\" during policy updates, preventing destructively large steps.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scaled CPI's concepts to deep neural networks by using a KL-divergence constraint to enforce a \"trust region\" during policy updates, preventing destructively large steps.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
