      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "link": null,
      "locked": false,
      "text": "Published parallel to TRPO, this introduced the exponentially-weighted advantage estimator\nused inside almost all modern PPO and TRPO implementations to balance variance and bias.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Published parallel to TRPO, this introduced the exponentially-weighted advantage estimator used inside almost all modern PPO and TRPO implementations to balance variance and bias.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
