      "version": 956,
      "versionNonce": 425245891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "locked": false,
      "text": " Introduced Group Relative Policy Optimization (GRPO). It builds on PPO but eliminates the need\nfor a memory-intensive value model (critic) by normalizing rewards across a group of sampled outputs\nfrom the same prompt, heavily optimizing RL for mathematical reasoning in LLMs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Introduced Group Relative Policy Optimization (GRPO). It builds on PPO but eliminates the need for a memory-intensive value model (critic) by normalizing rewards across a group of sampled outputs from the same prompt, heavily optimizing RL for mathematical reasoning in LLMs.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
