      "updated": 1792485689470,
      "locked": false,
      "text": "Direct Preference Optimization",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Direct Preference Optimization",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "n5e2ewuheCSSmOT5eocEA",
      "type": "text",
      "x": -17.656683692092884,
      "y": 522.0546851784765,
      "width": 772.6232299804688,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "EkA0PUJaFV7C-95fxhALd",
        "od870OtLxLpKU-inrjcNs"
      ],
      "frameId": null,
      "index": "b49",
      "roundness": null,
      "seed": 2123232387,
      "version": 718,
      "versionNonce": 1410656333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "locked": false,
      "text": "Fundamentally shifted LLM alignment by mathematically proving that the reward modeling phase\nand the RL optimization phase (like PPO) can be combined. It allows optimizing a policy directly\nfrom human preference data using a simple classification loss, completely eliminating the need for a\nseparate reward model or an unstable actor-critic loop.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fundamentally shifted LLM alignment by mathematically proving that the reward modeling phase and the RL optimization phase (like PPO) can be combined. It allows optimizing a policy directly from human preference data using a simple classification loss, completely eliminating the need for a separate reward model or an unstable actor-critic loop.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "kYdQC-8cpK6FgXFbbCbRG",
      "type": "image",
      "x": 66.88305700869978,
