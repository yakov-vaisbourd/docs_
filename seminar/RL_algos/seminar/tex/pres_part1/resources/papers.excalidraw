    {
      "id": "JxDb84aCd4EoxOYwsPwLa",
      "type": "text",
      "x": -17.656683692092884,
      "y": 252.41656711453572,
      "width": 772.6232299804688,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "EpGWEOwtYzv8EzSN0H7jU",
        "7oIJJh6n-S0dLpQoKTDf3"
      ],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 1696769379,
      "version": 542,
      "versionNonce": 869894563,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "locked": false,
      "text": "Introduced maximum entropy RL, adding an entropy bonus to the reward objective to encourage\nexploration and stabilize training. It remains the gold standard for sample-efficient continuous\ncontrol.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Introduced maximum entropy RL, adding an entropy bonus to the reward objective to encourage exploration and stabilize training. It remains the gold standard for sample-efficient continuous control.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
