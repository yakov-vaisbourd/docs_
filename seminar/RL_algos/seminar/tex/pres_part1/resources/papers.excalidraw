      "width": 531,
      "height": 40,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": null,
      "seed": 1921149987,
      "version": 782,
      "versionNonce": 1380339459,
      "updated": 1792485689470,
      "isDeleted": false,
      "groupIds": [
