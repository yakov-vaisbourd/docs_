      "customData": {
        "latex": "\\hat{P}[\\sigma^1 \\succ \\sigma^2] = \\frac{\\exp \\sum_t \\hat{r}(o_t^1, a_t^1)}{\\exp \\sum_t \\hat{r}(o_t^1, a_t^1) + \\exp \\sum_t \\hat{r}(o_t^2, a_t^2)}"
