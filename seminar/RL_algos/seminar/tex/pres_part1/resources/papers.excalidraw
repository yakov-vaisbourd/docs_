    {
      "id": "tkgXaad0Sr5kQPgtZ5W7b",
      "type": "text",
      "x": -17.656683692092884,
      "y": 81.23050579863445,
      "width": 772.6232299804688,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
