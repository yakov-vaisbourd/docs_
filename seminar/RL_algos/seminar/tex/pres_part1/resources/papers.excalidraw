      "fileId": "767ddd609349c03fe7960e6969febbc3b64a674b",
      "customData": {
        "latex": "\\mathcal{L}_{DPO}(\\pi_\\theta; \\pi_{ref}) = -\\mathbb{E}_{(x, y_w, y_l) \\sim \\mathcal{D}} \\left[ \\log \\sigma \\left( \\beta \\log \\frac{\\pi_\\theta(y_w|x)}{\\pi_{ref}(y_w|x)} - \\beta \\log \\frac{\\pi_\\theta(y_l|x)}{\\pi_{ref}(y_l|x)} \\right) \\right]"
      },
      "scale": [
        1,
        1
      ],
      "index": "b4A",
      "status": "pending",
      "crop": null
