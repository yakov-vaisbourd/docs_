      "version": 854,
      "versionNonce": 939478477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792485689470,
      "locked": false,
      "text": "Simplified TRPO by replacing the expensive KL penalty with a clipped surrogate objective function.\nThis became the industry standard for Reinforcement Learning from Human Feedback (RLHF).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Simplified TRPO by replacing the expensive KL penalty with a clipped surrogate objective function. This became the industry standard for Reinforcement Learning from Human Feedback (RLHF).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
